# Copy to .env and fill in. Never commit .env.

# Logging
LOG_LEVEL=INFO

# MCP client behavior
MCP_CALL_TIMEOUT_SECONDS=20

# LLM (Phase 3) — Ollama via OpenAI-compatible endpoint; pin a tool-capable model tag
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=

# Postgres (Phase 2+) — docker compose maps the container to host port 5433
# Admin DSN: schema setup + seeding only (scripts), never the MCP server.
OPS_ADMIN_DSN=postgresql://ops_admin:ops_admin_dev@localhost:5433/ops_agent
# Read-only DSN the postgres-mcp server connects with (role created by scripts/seed_db.py).
POSTGRES_MCP_DSN=postgresql://postgres_mcp_ro:ro_dev_password@localhost:5433/ops_agent
# Password assigned to the read-only role during seeding (dev default; change outside dev).
POSTGRES_MCP_RO_PASSWORD=ro_dev_password

# GitHub (Phase 4) — fine-grained PAT, READ-ONLY scopes only
GITHUB_TOKEN=
