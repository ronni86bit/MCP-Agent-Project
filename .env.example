# Copy to .env and fill in. Never commit .env.

# Logging
LOG_LEVEL=INFO

# MCP client behavior
MCP_CALL_TIMEOUT_SECONDS=20

# LLM (Phase 3) — Ollama via OpenAI-compatible endpoint; pin a tool-capable model tag
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=

# Postgres (Phase 2+) — business data + agent state + audit
DATABASE_URL=postgresql+asyncpg://ops_agent:ops_agent@localhost:5432/ops_agent

# GitHub (Phase 4) — fine-grained PAT, READ-ONLY scopes only
GITHUB_TOKEN=
