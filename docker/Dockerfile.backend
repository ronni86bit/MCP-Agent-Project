# Backend API + MCP runtime image (Phase 10 Gate 1).
#
# The investigation loop spawns the MCP servers as stdio subprocesses of this
# same process image (`sys.executable -m backend.mcp.servers.*` from
# backend/agent/service.py), so ONE image carries the API and all MCP servers.
# The venv is on PATH, which makes `sys.executable` resolve to the venv
# interpreter with every runtime dependency installed. PYTHONPATH is
# deliberately NOT set here: backend/mcp/client_manager.py injects the repo
# root (/app) via `setdefault`, preserving the local-dev behavior.
#
# Secrets are never baked in: configuration arrives only through the
# environment (compose / .env at runtime).

FROM python:3.12-slim AS runtime

# uv for frozen, reproducible installs from the existing lockfile.
COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUTF8=1

WORKDIR /app

# Dependency layer first: rebuilds only when the lockfile changes.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

# Application code (backend/ includes the MCP servers and scenario fixtures).
COPY backend ./backend
COPY scripts ./scripts

# Non-root runtime user owns /app (fixtures JSON is regenerated in-memory at
# runtime; nothing in the container needs to write to the image tree).
RUN useradd --create-home --uid 10001 appuser \
    && chown -R appuser:appuser /app
USER appuser

ENV PATH="/app/.venv/bin:${PATH}"

EXPOSE 8000

# 0.0.0.0 is required inside the container; host exposure is controlled by
# the Compose port mapping (127.0.0.1 only).
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
